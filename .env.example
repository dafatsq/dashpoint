# ==========================================
# 1. DOCKER & VPS DEPLOYMENT VARIABLES
# (Required for root .env or client env files)
# ==========================================
# Unique identifier for the client (crucial for container isolation)
PROJECT_NAME=dashpoint

# Host port mapping (Must be unique if multiple clients on same VPS)
BACKEND_PORT=8080
DB_PORT=5432

# Local Caddy Ports (Mainly if running Caddy locally via Docker)
CADDY_HTTP_PORT=8083
CADDY_HTTPS_PORT=8443

# Database Container Credentials (used to initialize Postgres)
POSTGRES_USER=dashpoint
POSTGRES_PASSWORD=dashpoint_dev
POSTGRES_DB=dashpoint_dev

# ==========================================
# 2. LOCAL GO APP VARIABLES (Bare Metal)
# (Required for backend/.env when running locally)
# ==========================================
# Server Configuration
PORT=8080
ENVIRONMENT=development

# Database Connection String
# Note: When using Docker Compose, this is automatically constructed in the .yml
DATABASE_URL=postgres://dashpoint:dashpoint_dev@localhost:5432/dashpoint_dev?sslmode=disable

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY_MINUTES=60
REFRESH_EXPIRY_HOURS=168

# Optional: Debug mode
DEBUG=false
