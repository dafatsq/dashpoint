# ==========================================
# 1. SHARED DEPLOYMENT / COMPOSE VARIABLES
# (Used by root .env files for Docker Compose and Caddy)
# ==========================================
PROJECT_NAME=dashpoint

# Host port mapping (must be unique if multiple clients share a host)
BACKEND_PORT=8080
DB_PORT=5432

# Public hostname used by Caddy
CADDY_SITE_ADDRESS=pos.example.com

# Per-client host storage root. Set a unique absolute path for each client on a shared VPS.
DATA_DIR=./data

# Legacy local Caddy port overrides kept for existing operator env files
CADDY_HTTP_PORT=8083
CADDY_HTTPS_PORT=8443

# Local development database container credentials. Replace for any shared or production deployment.
POSTGRES_USER=dashpoint
POSTGRES_PASSWORD=dashpoint_dev
POSTGRES_DB=dashpoint_dev

# ==========================================
# 2. BACKEND APPLICATION VARIABLES
# (Used by backend/.env and docker-compose backend service)
# ==========================================
PORT=8080
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# Local bare-metal database connection string
DATABASE_URL=postgres://dashpoint:dashpoint_dev@localhost:5432/dashpoint_dev?sslmode=disable
# Production DATABASE_URL must include sslmode=require, sslmode=verify-ca, or sslmode=verify-full.

JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY_MINUTES=15
REFRESH_EXPIRY_HOURS=168
DEBUG=false

# ==========================================
# 3. FRONTEND LOCAL VARIABLES
# (Used by frontend/.env.local)
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_ENABLE_QUICK_DEMO_ACCESS=false
