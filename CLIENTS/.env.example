# Copy this file to CLIENTS/.env.<client-slug> on the VPS.
# Keep the client file outside version control and chmod it to 600.

# Compose/container identity. Use lowercase letters, numbers, hyphens, or underscores.
PROJECT_NAME=client-slug

# Public domain served by the shared Caddy instance.
CADDY_SITE_ADDRESS=client.example.com
CADDY_API_ONLY=false
CORS_ORIGINS=https://client.example.com,wails://wails,http://wails.localhost

# Unique host path for this client's database, TLS files, and uploads.
DATA_DIR=/opt/dashpoint/clients/client-slug/data

# Use unique values for every client.
POSTGRES_USER=client_db_user
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=client_prod
JWT_SECRET=replace-with-at-least-32-random-characters

# Application settings.
JWT_EXPIRY_MINUTES=15
REFRESH_EXPIRY_HOURS=168
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_ENABLE_QUICK_DEMO_ACCESS=false

# Comma-separated proxy addresses allowed to set X-Forwarded-For/Proto.
# Behind the shared Caddy container this is the Docker bridge subnet; without
# it, rate limits collapse into one deployment-wide bucket, audit entries
# record Caddy's IP, and cookies lose the Secure flag.
TRUSTED_PROXIES=172.18.0.0/16

# Shared Docker network used by the global Caddy container.
PROXY_NETWORK=dashpoint_proxy
